# Console主机的环境变量。复制为 .env 并填写；切勿提交 .env 到版本库。
#
# 注意：Console是独立主机、独立数据库，与节点的 deploy/.env 完全无关，
# 两边的密码与密钥都不应相同。

# 公开站点域名（落地页/下载/查询页）。DNS必须已指向本机，Caddy才能签发证书。
CCW_SITE_DOMAIN=ccw.example.com

# 管理后台域名：**必须与站点域名不同**（设计§8.3）。后台功能尚未实施，
# 但域名与DNS建议现在就备好——证书签发要时间，且改域名会触发重签。
CCW_ADMIN_DOMAIN=admin.example.com

# 管理后台的IP白名单（Caddy remote_ip语法，空格分隔的IP或CIDR）。
# 白名单之外访问管理域名返回404。示例：203.0.113.7 198.51.100.0/24
# Caddy与应用层**各自独立校验**这份名单：反代配置写错时应用层兜底。
CCW_ADMIN_ALLOWLIST=127.0.0.1

# 信封加密主密钥（64位hex）。生成：openssl rand -hex 32
# 加密托管SSH私钥、云厂商凭据、管理员的两步验证密钥。
# **丢失即全部不可解**（需重建管理员账号、对每台机器重新纳管）——务必单独备份。
# 与CCW_ADMIN_ALLOWLIST同时设置时才会启用管理后台；缺任一项则/admin路由不注册。
CCW_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32

# Console数据库密码（自定义强密码；与节点的POSTGRES_PASSWORD无关）
CONSOLE_POSTGRES_PASSWORD=change-me-to-a-strong-password

# 数据库数据目录（bind到Docker data-root之外，避免磁盘被撑爆时连库一起挂）。
# 首次启动前：sudo mkdir -p /var/lib/ccw-console/pgdata
CONSOLE_PGDATA=/var/lib/ccw-console/pgdata

# 客户端产物目录（make release 的输出同步到这里，只读挂进容器）。
# 首次启动前：sudo mkdir -p /srv/ccw-console/dist
CONSOLE_DIST_DIR=/srv/ccw-console/dist

# Console自身版本号（注入二进制，出现在启动日志里）
CONSOLE_VERSION=dev
