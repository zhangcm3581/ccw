# 项目容器镜像：官方Claude Code + git + tmux，非root用户claude，PID 1为sleep infinity。
#
# Claude Code 用**官方安装脚本**装（2026-07-29定），不再走npm：
# 官方脚本装的是自带运行时的原生二进制，不需要Node，也就不用为了它拖一整套
# nodesource源与nodejs包。镜像更小、层更少，升级路径也与官方文档一致。
# **ARG 必须在所有 FROM 之前**：只有第一个 FROM 之前的 ARG 才是全局的，
# 写在某个阶段里就只属于那个阶段。2026-08-01 加状态行的构建阶段时把它挤到了
# 后面，于是 `FROM ubuntu:${UBUNTU_TAG}` 解析成 `ubuntu:`，
# 报 "failed to parse stage name" —— 整个 compose-up 就是这样失败的。
ARG UBUNTU_TAG=24.04

# 状态行程序：读 Claude 从 stdin 传来的会话 JSON，渲染成一行。
# 编成静态二进制而不是往镜像里装 jq 写 shell——1/8 格精度的进度条与倒计时
# 用 shell 写既难读也难验，Go 才能对这几段逻辑做单测。
# 版本与其余镜像一致（versions.lock 的 go-build-image）。
FROM golang:1.22-bookworm AS statusline
WORKDIR /src
# 与其余 Dockerfile 同款分层：先只拷 go.mod/go.sum 下模块，源码改动就不必
# 重下一遍依赖。ccw-statusline 只用标准库，但构建仍要解析模块图。
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/ccw-statusline ./cmd/ccw-statusline

FROM ubuntu:${UBUNTU_TAG}
# UTF-8 locale：否则 Claude Code 的 Unicode 界面显示成占位符、且无法输入中文
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ARG CLAUDE_CODE_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends git tmux curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# tmux 配置：默认值里有两条在这套用法下是错的（default-terminal=screen 让
# Claude 以为只有 8 色；mouse=off 让滚轮不归 tmux 管，滚动后画面留残影）。
# 详见文件内注释。放 /etc 而不是 ~/.tmux.conf——管理员授权用的那个会话
# （DEPLOY.md A7）也要吃到同一份配置。
COPY deploy/tmux.conf /etc/tmux.conf

# Claude Code 的状态行：显示本项目的内部额度。
#
# **放 managed-settings 而不是 ~/.claude/settings.json**：后者在 claude-shared
# 卷里，卷已经初始化过之后镜像里的同名文件根本不会出现（空卷只在首次挂载时
# 用镜像内容初始化）。/etc 不是卷，重建镜像即生效。
# 代价：managed 优先级最高、用户无法覆盖自己的 statusLine——额度是这套系统的
# 硬约束（整机共用一个上游账号），让它始终可见是有意的取舍。
#
# 数据全部来自 Claude 自己（rate_limits 是上游账号的真实额度与真实重置时间），
# 不经过 worker-agent——少一条要维护的链路，也少 30 秒的滞后。
RUN mkdir -p /etc/claude-code
COPY deploy/claude-managed-settings.json /etc/claude-code/managed-settings.json
COPY --from=statusline /out/ccw-statusline /usr/local/bin/ccw-statusline

RUN useradd -m -u 1001 -s /bin/bash claude

# 以claude身份安装：官方脚本装进 $HOME/.local/bin，装成root的话
# 运行时用户根本看不到它。
#
# **版本固定的现状**：CLAUDE_CODE_VERSION非空时传给脚本，否则装latest。
# 后者与CLAUDE.md「禁止未固定版本」有张力，与install-docker那一步同款取舍，
# 已在versions.lock如实记为未固定项——不在这里写一句"已固定"了事。
USER claude
RUN if [ -n "${CLAUDE_CODE_VERSION}" ]; then \
      curl -fsSL https://claude.ai/install.sh | bash -s -- "${CLAUDE_CODE_VERSION}"; \
    else \
      curl -fsSL https://claude.ai/install.sh | bash; \
    fi \
 && /home/claude/.local/bin/claude --version

# PATH对**全部入口**都要生效，缺一不可：
#   - ENV：docker exec 的非交互命令（worker-agent 起 tmux 用的就是这条路）
#   - .bashrc：交互式 shell（管理员 docker exec -it bash 进来手敲）
# 只设其一的表现是"我能跑 claude、worker-agent 却报 command not found"。
ENV PATH=/home/claude/.local/bin:$PATH
RUN echo 'export PATH=/home/claude/.local/bin:$PATH' >> /home/claude/.bashrc

# 预建挂载目录并归 claude(1001) 所有。关键：空命名卷首次挂载到容器路径时，
# Docker 会用镜像内该路径的内容与所有权初始化卷——因此这里 chown 后，
# workspace/claude-home/sync 卷都会是 claude 所有，避免默认 root:root
# 导致 claude 无法写入 .credentials.json（登录后 loggedIn=false、反复要求登录的根因）。
#
# .claude/projects 必须单独预建：它是每项目独立卷的挂载点（compose 里的
# <slug>-claude-projects），同样受上述卷初始化规则约束，漏建会以 root:root
# 初始化，导致会话 JSONL 写不进去。凭据文件 .claude/.credentials.json 是它的
# 兄弟节点，不在遮蔽范围内——因此账号仍然全机只授权一次（设计 §7.3）。
USER root
RUN mkdir -p /home/claude/.claude/projects /workspace /var/lib/cclaude-sync \
 && chown -R claude:claude /home/claude /workspace /var/lib/cclaude-sync
USER claude
WORKDIR /workspace
# PID 1不是tmux（无TTY会立即退出）；tmux由worker-agent经docker exec准备。
CMD ["sleep", "infinity"]
