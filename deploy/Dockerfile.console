# ccw-console：静态Go二进制，distroless运行（与control-api同款）。
# 站点模板由go:embed打进二进制，运行层无需任何静态文件；
# 客户端产物（CCW_DIST_DIR）由卷挂进来，不进镜像。
FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG CONSOLE_VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X main.buildVersion=${CONSOLE_VERSION}" \
      -o /out/ccw-console ./cmd/ccw-console

# 节点源码包：纳管时推送到节点，节点靠它构建自己的镜像。
# **必须包含完整Go源码**——节点的compose.yaml用 `context: ..` +
# `dockerfile: deploy/Dockerfile.X`，而各Dockerfile都 `COPY . .` 后从源码构建。
# 排除.git与文档：节点不需要，且能显著减小传输量。
RUN tar czf /out/node-src.tar.gz \
      --exclude=./.git --exclude=./docs --exclude=./dist \
      --exclude=./.github --exclude=./tests \
      -C /src . \
 && ls -lh /out/node-src.tar.gz

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/ccw-console /ccw-console
COPY --from=build /out/node-src.tar.gz /node-src.tar.gz
EXPOSE 8090
ENTRYPOINT ["/ccw-console"]
