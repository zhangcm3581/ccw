flowchart LR
  A["客户端连上<br/>/ws/terminal"] --> B{"tmux has-session ?"}
  B -->|"有"| D["attach-session"]
  B -->|"没有"| C["new-session -d<br/>工作目录 /workspace"]
  C --> D
  D --> E["docker exec -it<br/>容器侧 TTY"]
  E --> F["creack/pty<br/>宿主机侧 TTY"]
